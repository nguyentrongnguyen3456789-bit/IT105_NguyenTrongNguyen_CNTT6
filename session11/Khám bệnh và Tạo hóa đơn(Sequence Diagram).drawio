        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor \&quot;:NhaSi\&quot; as NS\nparticipant \&quot;:KhamBenhUI\&quot; as UI\nparticipant \&quot;:RecordService\&quot; as RS\nparticipant \&quot;:InvoiceService\&quot; as IS\ndatabase \&quot;:CSDL\&quot; as DB\n\nNS -&gt; UI: Nhập kết quả khám bệnh\nUI -&gt; RS: createMedicalRecord(data)\nRS -&gt; DB: save(MedicalRecord)\nDB --&gt; RS: success\nRS -&gt; IS: triggerCreateInvoice(recordId)\n\nloop [cho mỗi dịch vụ đã thực hiện]\n  IS -&gt; IS: addInvoiceDetail(service, quantity)\n  IS -&gt; IS: lineTotal = unitPrice * quantity\nend\n\nIS -&gt; IS: totalAmount = SUM(lineTotal) (Self Message)\nIS -&gt; DB: save(Invoice)\nDB --&gt; IS: success\nIS --&gt; UI: return(invoiceId)\n\nopt [Bệnh nhân yêu cầu in hóa đơn]\n  UI -&gt; IS: printInvoice(invoiceId)\n  IS --&gt; UI: pdf_data\nend\nUI --&gt; NS: \&quot;Hoàn tất khám &amp; lưu hóa đơn\&quot;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CTK7FbKW3bXL-E0QvIAw-1">
